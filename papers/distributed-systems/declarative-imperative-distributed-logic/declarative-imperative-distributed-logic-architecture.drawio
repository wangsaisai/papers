        <mxCell id="lg4t" value="猜想 / 定理（CALM）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="legend">
          <mxGeometry x="50" y="105" width="280" height="20" as="geometry" />
        </mxCell>
