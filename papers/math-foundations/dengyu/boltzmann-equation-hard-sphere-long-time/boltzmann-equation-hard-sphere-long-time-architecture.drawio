<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Long Time Derivation of the Boltzmann Equation from Hard Sphere Dynamics" id="boltzmann-equation-hard-sphere-long-time">
    <mxGraphModel dx="1440" dy="1560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t0" value="从硬球动力学的长时间推导玻尔兹曼方程（Long Time Derivation of the Boltzmann Equation from Hard Sphere Dynamics）&#10;定理 1 证明结构图：时间分层 + 累积量展开 + 分子图论 + 切割算法" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=middle;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n01" value="假设：硬球系统（Hard Sphere System）&#10;d ≥ 2、N 个直径 ε 的球，巨正则系综（粒子数随机）&#10;玻尔兹曼-格拉德标度律：E(N)·ε^(d-1) ≈ 1&#10;（背景：Lanford 1975 仅短时；波动力学长时范式 [23]）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n02" value="假设：玻尔兹曼方程解存在（Boltzmann Solution）&#10;初始 f0 ≥ 0、∫f0 = 1；解 f(t) 在 [0, t_fin] 上存在&#10;t_fin 可以任意大——覆盖解整个生命周期&#10;（f^A 收敛到玻尔兹曼解是结论的第 (a) 部分）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="420" height="110" as="geometry" />
        </mxCell>

        <mxCell id="n03" value="步骤①｜时间分层（Time Layering）&#10;[0, t_fin] 切成 L 个短窗口 [0, τ], [τ, 2τ], …&#10;每段足够小，使逐层收敛级数展开成立&#10;（规避整体展开 ∑ Cⁿ·tⁿ 的收敛半径限制）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n04" value="步骤②｜累积量展开（Cumulant Expansion）&#10;f_s = ∏_j f^A(t,z_j) + Σ_H (∏_{j∉H} f^A)·E_H&#10;E_H 度量偏离独立性的真实关联，是证明的核心对象&#10;（目标：(a) f^A → BE 解；(b) ‖E_H‖_(L¹) → 0）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="260" width="420" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n05" value="步骤③｜部分时间展开（Partial Time Expansion）·关键突破&#10;不把主导项 f^A 一路展开回时刻 0（避免 tⁿ 发散）&#10;只展开累积量项：ε^(α|H|) 的幂增益足以抵消组合爆炸&#10;需传播超越任何范数的结构性信息（直接范数归纳与&#10;牛顿时间可逆性相矛盾的深层原因）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="440" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n06" value="步骤④｜分子表示（Molecule Representation）&#10;累积量展开后：粒子碰撞历史拓扑约化为抽象图——分子&#10;粒子＝线、碰撞＝节点；忽略精确位置与时刻&#10;只保留组合结构（谁撞谁、先后、在哪一层）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n07" value="步骤⑥｜截断动力学（Truncated Dynamics）&#10;若一次碰撞将导致聚类粒子数/再碰撞数超阈值 ⇒ “关闭”这次碰撞&#10;（允许粒子彼此穿过），分子复杂度受限、不失控&#10;截断误差可严格控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="640" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n08" value="步骤⑤｜约化到两个分子估计（Two Key Bounds）&#10;分子族数量界：#M ≤ C^|M| · |log ε|^(Cρ)&#10;单个分子积分界：‖Val_M‖_(L¹) ≤ τ^|M| · ε^(υρ)&#10;ρ＝再碰撞数（作为无向图的环秩）；只需 ε ≪ τ ≪ 1&#10;每次再碰撞：计数损失 |log ε|^C，重整化概率得 ε^υ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b3;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="640" width="420" height="160" as="geometry" />
        </mxCell>

        <mxCell id="n09" value="步骤⑦｜切割算法（Cutting Algorithm）·主要技术创新&#10;按 Fubini 定理把大分子逐步切成初等分子 {3}, {33}…&#10;（A）层精化 + 层选择 ⇒ 多层情形归约到两层情形&#10;（B）两层情形按两种主要场景二分处理&#10;切割出 {33} 型（碰撞后再碰撞）每次产生 ε^υ 增益，抵消组合增长" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="840" width="420" height="160" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="核心引理｜累积量小性估计（Cumulant Smallness）&#10;对 H ⊆ [s]、s ≤ |log ε| 一致地成立：&#10;‖E_H(t)‖_(L¹) ≤ ε^(α|H|)（t 在每个窗口内）&#10;⟹ 长时间累积量假设（Long-time Cumulant Ansatz）得以传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1040" width="440" height="140" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="定理 1（主定理 · 结论）&#10;sup_{(t, z_s)} ‖ f_s(t) − ∏_{j≤s} f(t, z_j)·1_(D_s) ‖_(L¹) ≤ ε^θ&#10;对 t ∈ [0, t_fin]（t_fin 可任意大）、s ≤ |log ε| 一致成立&#10;θ > 0 仅依赖维度 d&#10;⟹ 从硬球动力学对任意长时间严格推导玻尔兹曼方程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1290" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="物理意蕴｜时间之箭（Arrow of Time）&#10;时间可逆的牛顿动力学（微观）&#10;→ 时间不可逆的玻尔兹曼方程（宏观，熵增）&#10;最严格的数学路径之一；配合流体动力学极限即可完成希尔伯特第六问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="lx0" value="图例 Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1490" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lx1" value="" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="lx0">
          <mxGeometry x="10" y="35" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lx1t" value="假设 / 设定（设定与假设）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="33" width="400" height="20" as="geometry" />
