        <mxCell id="lx3t" value="关键技术 / 创新工具（橙色）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="81" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lx4" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lx0">
          <mxGeometry x="10" y="107" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lx4t" value="主定理 / 结论（绿色）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="105" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lx5" value="" style="rounded=0;html=1;fillColor=#ffd9b3;strokeColor=#d79b00;" vertex="1" parent="lx0">
          <mxGeometry x="10" y="131" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lx5t" value="关键量估计 / 归约命题（橙浅）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="129" width="400" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e01" value="系综给出每窗口随机初值" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n01" target="n03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e02" value="系综关联函数 f_s 展开基础" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n01" target="n04">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e03" value="每窗口内 BE 解局部存在" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n02" target="n03">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e04" value="逐层推进（每层以起点展开）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n03" target="n05">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e05" value="只对累积量项展开，保留主导项" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n04" target="n05">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e06" value="碰撞史组合结构　→ 分子" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n05" target="n06">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e07" value="借图论结构做组合估计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n05" target="n08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e08" value="截断：关闭超限碰撞，结构可控" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n07" target="n08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e09" value="分子量界的成立前提" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n06" target="n08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="为估计单个分子积分而设计切法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n09" target="n08">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="每个初等分子小块: ε^υ 增益" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n09" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="两条分子界 ⇒ 累积量小性" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n08" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="逐层传播 ⇒ f_s(T) 逼近乘积形 f 一致" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="物理意义（时间之箭）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>