          <mxGeometry x="10" y="59" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lx2t" value="中间推导步骤 / 一般工具（蓝色）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="57" width="400" height="20" as="geometry" />
