<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Hilbert's Sixth Problem: Derivation of Fluid Equations via Boltzmann's Kinetic Theory" id="hilbert-sixth-problem-fluid-equations">
    <mxGraphModel dx="1440" dy="1480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t0" value="希尔伯特第六问题：通过玻尔兹曼动力学理论推导流体方程（Hilbert&apos;s Sixth Problem）&#10;证明结构图：牛顿（硬球）→ 玻尔兹曼方程（动力学极限）→ 流体方程（流体动力学极限）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=middle;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n01" value="假设｜微观硬球系统（Micro System）&#10;环面 T^d（d = 2, 3）：N 个直径 ε 的硬球&#10;直线运动 + 每次相切时弹性碰撞（动量守恒）&#10;状态 z_j = (x_j, v_j)；域 D_N；流算子 S_N(t)&#10;玻尔兹曼方程解近麦克斯韦分布全局存在（光滑数据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n02" value="假设｜标度与随机数据（Scales and Data）&#10;玻尔兹曼-格拉德标度：α = N·ε^(d-1)（稀薄气体设置）&#10;巨正则系综：W_0 = (1/N!)·∏ n_0(z_j)·1_(D_N)&#10;两步极限：α 固定（第一步）；α → ∞（第二步）&#10;初始 n_0 非负、∫ n_0 = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n03" value="第一步｜动力学极限 → 玻尔兹曼方程（定理 1）&#10;迭代极限 N → ∞、ε → 0，保持 α = N·ε^(d-1) 固定：&#10;粒子系统单粒子密度逼近玻尔兹曼方程解：&#10;（∂_t + v·∇_x）n = α·Q(n,n)（硬球碰撞核）&#10;环面新难点：固定粒子碰撞次数无上界（与欧几里得相反，粒子不会彼此远离）&#10;⇒ 引入新切割算法与新积分检验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="440" height="175" as="geometry" />
        </mxCell>

        <mxCell id="n04" value="关键连接｜两个极限之间的时间链（长时间推导）&#10;在 O(1) 时间区间上推导玻尔兹曼方程 ⇒ 等价于（重新标度 t, x 后）&#10;α = 1 的 BE 解在长度 ≥ α 的时间区间上存在&#10;因流体动力学极限中 α → ∞，必须先获得玻尔兹曼方程的长时间推导&#10;⟸ 前作硬球长时间推导（arXiv 2408.07818）在此经环面化推广" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="440" height="155" as="geometry" />
        </mxCell>

        <mxCell id="n05" value="第二步｜流体动力学极限（定理 2, 3）&#10;碰撞率 α → ∞（克努森数 → 0，平均自由程 → 0）&#10;玻尔兹曼方程解 → 宏观流体方程&#10;两个变体：不可压缩 Navier-Stokes-Fourier / 可压缩 Euler&#10;迭代极限次序：先 N→∞, ε→0（α 固定），再 α→∞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="760" width="440" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n06" value="工具｜Hilbert 展开 / Chapman-Enskog 展开&#10;将 BE 解表示为围绕局部 Maxwell 分布的微扰级数&#10;在合适标度极限下高阶项消失（留宏观方程）&#10;（流体动力学极限的经典渠道）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1020" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n07" value="工具｜紧性论证（Compactness）&#10;通过紧性将依赖时间 t 的常数改进为&#10;仅依赖维度 d 等基本参数的均匀估计&#10;（两步极限交换时的收敛保证）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="1020" width="440" height="130" as="geometry" />
        </mxCell>

        <mxCell id="n08" value="定理 2｜从牛顿定律推导不可压缩 NS-Fourier 系统&#10;（近全局平衡的同一硬球系统）&#10;宏观密度与速度的有效方程（迭代极限）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n09" value="定理 3｜从牛顿定律推导可压缩 Euler 方程&#10;同一硬球系统，迭代极限（先 N→∞, ε→0 α 固定；再 α→∞）&#10;宏观密度、速度、温度的有效方程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1220" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="总结｜完成 Hilbert 第六问题（牛顿 → 流体）&#10;两个极限正确组合：牛顿（可逆）→ 玻尔兹曼（不可逆）→ 流体方程&#10;时间之箭的严格数学基础之一&#10;完成 125 年悬而未决的希尔伯特程序（玻尔兹曼动力学路径）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="1220" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="lx0" value="图例 Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;fontSize=13;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1430" width="460" height="120" as="geometry" />
        </mxCell>
