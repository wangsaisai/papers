        <mxCell id="lx2t" value="推导步骤 / 两个极限（蓝）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="57" width="380" height="20" as="geometry" />
