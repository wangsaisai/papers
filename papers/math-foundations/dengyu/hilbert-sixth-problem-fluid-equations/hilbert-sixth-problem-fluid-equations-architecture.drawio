          <mxGeometry x="10" y="107" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lx4t" value="定理 / 结论（绿）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="105" width="380" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e01" value="微观系统（第一步输入）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n01" target="n03">
          <mxGeometry relative="1" as="geometry" />
