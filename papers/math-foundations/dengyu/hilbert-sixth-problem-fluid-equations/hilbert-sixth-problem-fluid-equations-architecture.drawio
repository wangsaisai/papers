        <mxCell id="lx3t" value="关键环节 / 工具（橙）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="lx0">
          <mxGeometry x="50" y="81" width="380" height="20" as="geometry" />
