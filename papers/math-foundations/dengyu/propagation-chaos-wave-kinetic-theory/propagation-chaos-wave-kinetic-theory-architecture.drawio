<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Propagation of Chaos and the Higher Order Statistics in the Wave Kinetic Theory" id="propagation-chaos-wave-kinetic-theory">
    <mxGraphModel dx="1440" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t0" value="波动力学理论中的混沌传播与高阶统计量（Propagation of Chaos in the Wave Kinetic Theory）&#10;定理 1.3 证明结构图：WKH 层级 + 费曼图分析 + 高斯/非高斯传播" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=middle;align=center;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1400" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n01" value="设定｜动力学框架（Wave Kinetic Setup）&#10;d ≥ 3，大环面 T_L^d 上三次 NLS（扭曲拉普拉斯 Δ_β）&#10;随机初始数据 û_in(k) = √n_in(k)·η_k，η_k 独立同分布&#10;Eη_k = 0、E|η_k|² = 1；标度 α = L^(-1)，T_kin = L²/2&#10;β 一般（丢番图条件，坏集 Z 的补集）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n02" value="初始分布两种情形&#10;高斯情形：η_k 为标准复高斯&#10;非高斯情形：任意 iid 分布&#10;光滑解保证：NLS 在 [0, T]（T = δ·T_kin）上&#10;有光滑解，概率 ≥ 1 − L^(-A)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n03" value="前提｜先驱结果 [12]（定理 1.1）&#10;二阶矩 E|û(t,k)|² 在动力学极限下→ 收敛到&#10;WKE 解 n(t/T_kin, k)（O(1)·T_kin 时间尺度）&#10;本文目的：在其分析基础上后验建立高阶矩统计——&#10;混沌传播、层级、高斯/非高斯传播（同时处理）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="420" height="160" as="geometry" />
        </mxCell>

        <mxCell id="n04" value="工具① 波动力学层级（WKH）&#10;高阶傅里叶矩的渐近行为由 WKH 的解给出&#10;（波动力学层级的自然推广：K(k₁,k₂,k₀)-型核的层级）&#10;对一般（非因子化）初始数据也严格成立&#10;因子化初始数据为其特别情形" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n05" value="工具② 费曼图分析（Ternary Trees / Feynman）&#10;NLS 迭代的所有高阶项表示为三元树（费曼图）&#10;(a) 识别主导图（正则对 regular couples）&#10;(b) 证明其余图贡献可忽略&#10;(c) 控制迭代余项——不完全：需概率显式分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="310" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n06" value="工具③ 概率临界性（Probabilistic Criticality）&#10;图数量呈阶乘增长，须与概率衰减平衡&#10;余项必须系统性控制（概率估计、超收缩性）&#10;（该分析同时给出了非因子化数据的层级）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="310" width="420" height="170" as="geometry" />
        </mxCell>

        <mxCell id="n07" value="关键步骤｜因子化初始数据&#10;初始独立（因子化）⇒ WKH 解保持因子化结构&#10;＝混沌传播的精确定义（独立性在动力学极限中恢复&#10;；极限前动力学自然制造关联）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n08" value="高斯情形｜高斯性传播&#10;初始高斯 ⇒ 极限分布保持高斯性&#10;矩公式：E[∏ |û|^{2p_j}] ≈ ∏ p_j! · n(t/T_kin, k_j)^{p_j}&#10;（所有其他矩 ≈ 0）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="530" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="n09" value="非高斯情形｜极限方程（新结果）&#10;推导高阶矩与概率密度函数（PDF）的极限方程&#10;部分印证物理文献中的猜想，部分结果全新&#10;（此前完全开放）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="530" width="420" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="定理 1.3｜混沌传播（高斯）·绿色结论&#10;p_j ≠ q_j：E[∏_j û^{p_j} ū^{q_j}] → 0（L → ∞，0 的一致余项误差）&#10;p_j = q_j：E[∏_j |û|^{2p_j}] ≈ ∏_j (p_j)! · n^{p_j}&#10;⟹ 不同波数模式在动力极限下独立：每个矩由 WKE 解 n 决定&#10;（= WKE 已是第二阶的完整统计）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="740" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="副产品｜高斯性传播&#10;渐近分布保持高斯性（极限）&#10;分布矩完全由 WKE 解 n 决定的独立乘积形式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="副产品｜非高斯情形的完整统计&#10;推导高阶矩 + PDF 极限方程（新结果）&#10;动量极限中解统计量的完整描述（高斯与非高斯）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="900" width="420" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e01" value="WKH（提供层级方程）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n01" target="n04">
