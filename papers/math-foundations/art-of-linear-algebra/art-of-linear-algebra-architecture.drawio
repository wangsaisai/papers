        <mxCell id="la1" value="① 理解矩阵的四个视角 Four Views of a Matrix" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="la11" value="一个矩阵（整体）&#10;从 ℝⁿ 到 ℝᵐ 的线性变换 A&#10;—— 全书核心：矩阵 = 变换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="la1">
          <mxGeometry x="25" y="40" width="320" height="115" as="geometry" />
        </mxCell>
        <mxCell id="la12" value="mn 个数（逐个元素）&#10;矩阵是数据的存放表格&#10;（存数视角）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="la1">
          <mxGeometry x="375" y="40" width="320" height="115" as="geometry" />
        </mxCell>
        <mxCell id="la13" value="n 个列（按列看）&#10;n 个 m 维列向量的集合&#10;（列视角 → P1 模式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="la1">
          <mxGeometry x="725" y="40" width="320" height="115" as="geometry" />
        </mxCell>
        <mxCell id="la14" value="m 个行（按行看）&#10;m 个 n 维行向量的集合&#10;（行视角 → P2 模式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="la1">
          <mxGeometry x="1075" y="40" width="320" height="115" as="geometry" />
        </mxCell>

        <mxCell id="la2" value="② 向量乘法 · 矩阵乘法的视角 Vector x Matrix Multiplication" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="220" width="1400" height="330" as="geometry" />
        </mxCell>
        <mxCell id="la21" value="向量乘法 视角 1 · 点积 Dot Product&#10;a · b = Σ aᵢbᵢ&#10;对应项相乘再相加 → 得到一个数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="la2">
          <mxGeometry x="25" y="40" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="la22" value="向量乘法 视角 2 · 外积 Outer Product（关键钥匙）&#10;a · bᵀ —— 列乘行&#10;→ 得到秩 1 矩阵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="la2">
          <mxGeometry x="455" y="40" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="la23" value="MM1 行 × 列（点积）&#10;逐元素计算&#10;（教科书标准算法）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="la2">
          <mxGeometry x="25" y="170" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="la24" value="MM2 列 × 行&#10;C 的每列 = A 的列的&#10;线性组合（P1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="la2">
          <mxGeometry x="375" y="170" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="la25" value="MM3 行 × 列&#10;C 的每行 = B 的行的&#10;线性组合（P2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="la2">
          <mxGeometry x="725" y="170" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="la26" value="MM4 外积求和（列×行）&#10;C = Σ 列×行 = 若干秩 1 矩阵之和&#10;★ 五种分解的统一视角" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="la2">
          <mxGeometry x="1075" y="170" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="la3" value="③ 四种实用模式 Four Patterns（反复出现的视觉模式）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="570" width="1400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="la31" value="P1 右乘矩阵 = 对列做线性组合&#10;用于 CR、QR 分解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="la3">
          <mxGeometry x="25" y="40" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la32" value="P2 左乘矩阵 = 对行做线性组合&#10;用于 LU 分解" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="la3">
          <mxGeometry x="375" y="40" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la33" value="P3 X·D·c 模式（特征展开）&#10;特征值/特征向量 → 微分、差分方程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="la3">
          <mxGeometry x="725" y="40" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la34" value="P4 U·Σ·Vᵀ 模式（三矩阵·中间对角）&#10;特征值分解、SVD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="la3">
          <mxGeometry x="1075" y="40" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="la4" value="④ 五种矩阵分解 Five Matrix Decompositions" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="770" width="1400" height="440" as="geometry" />
        </mxCell>
        <mxCell id="la41" value="A = CR（列–行分解）&#10;C: 线性无关的列，R: 行阶梯形&#10;直观证明：列秩 = 行秩&#10;&#10;类比：挑“代表”C + 每人写总结 R，&#10;还原全班发言 A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="la4">
          <mxGeometry x="25" y="40" width="255" height="370" as="geometry" />
        </mxCell>
        <mxCell id="la42" value="A = LU（高斯消去）&#10;L 下三角 · U 上三角&#10;解 Ax = b 分两步：先解 Lc = b，&#10;再解 Ux = c&#10;&#10;类比：穿鞋脱袜，先鞋带后袜子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="la4">
          <mxGeometry x="305" y="40" width="255" height="370" as="geometry" />
        </mxCell>
        <mxCell id="la43" value="A = QR（Gram–Schmidt 正交化）&#10;Q: 正交基；R: 三角矩阵&#10;把歪斜的列逐个扶正，&#10;记录每次扶正幅度&#10;&#10;类比：扶正积木并记录角度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="la4">
          <mxGeometry x="585" y="40" width="255" height="370" as="geometry" />
        </mxCell>
        <mxCell id="la44" value="A = UΣVᵀ（奇异值分解 SVD）&#10;所有矩阵（含长方阵）都可 &#10;A = σ₁u₁v₁ᵀ + σ₂u₂v₂ᵀ + …&#10;秩 1 层按重要性 σ 排序&#10;&#10;类比：照片压缩的基础图层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="la4">
          <mxGeometry x="865" y="40" width="255" height="370" as="geometry" />
        </mxCell>
        <mxCell id="la45" value="S = QΛQᵀ（对称矩阵的特征值分解）&#10;特征值全为实数 · 特征向量正交&#10;S = λ₁q₁q₁ᵀ + λ₂q₂q₂ᵀ + …&#10;&#10;类比：把性格拆成独立特质" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="la4">
          <mxGeometry x="1145" y="40" width="255" height="370" as="geometry" />
        </mxCell>

