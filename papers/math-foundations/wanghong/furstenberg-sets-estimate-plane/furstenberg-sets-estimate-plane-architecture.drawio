        <mxCell id="fs5" value="④ 尺度归纳 Scale Induction（源自 [30]）&#10;把分支 A（均匀）+ 分支 B（稀疏）逐尺度拼接为 |T|_δ ≳ ε · δ^{-(s+t)/2 + ε} M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="fs2">
          <mxGeometry x="330" y="645" width="780" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fs6" value="主定理 Theorem 1.1（离散版：定理 4.1）&#10;任意 (s,t)-Furstenberg 集 F ⊂ ℝ²：dim_H F ≥ min{s+t, (3s+t)/2, s+1}&#10;下界与 Wolff 构造的上界匹配 → 最优，二维 Furstenberg 集猜想完全解决" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="940" width="1000" height="120" as="geometry" />
        </mxCell>

        <mxCell id="fs7" value="推论与应用 Corollaries（主定理的直接副产品）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="1100" width="1400" height="230" as="geometry" />
        </mxCell>
        <mxCell id="fs71" value="推论 1 · Oberlin 正交投影例外集猜想（定理 1.2）&#10;任意 Borel 集 K ⊂ ℝ²，0 ≤ u ≤ min{dim_H K, 1}：&#10;dim_H {θ ∈ S¹ : dim_H π_θ(K) &lt; u} ≤ max{2u − dim_H K, 0}&#10;（调和分析限制问题的新视角）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="fs7">
          <mxGeometry x="25" y="38" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fs72" value="推论 2 · 离散和积估计（定理 1.5）&#10;Elekes 界限的类比（指数 7/6 → 5/4，推广 Máthé-O'Regan 与 [31]）&#10;对 (δ, s, δ^{-ε})-集 A：&#10;max{|A+A|_δ, |A·A|_δ} ≥ δ^{-(5/4)s + η}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="fs7">
          <mxGeometry x="615" y="38" width="560" height="170" as="geometry" />
