  <diagram name="Furstenberg-Proof-Architecture" id="furstenberg-sets-estimate-plane">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1540" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fs1" value="设定 · Problem Setup（(s,t)-Furstenberg 集猜想，Furstenberg 1969）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="fs11" value="定义 (s,t)-Furstenberg 集&#10;E ⊂ ℝ²，存在直线族 L：dim_H L ≥ t，&#10;对每条 ℓ ∈ L 有 dim_H (E ∩ ℓ) ≥ s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="fs1">
          <mxGeometry x="25" y="40" width="380" height="95" as="geometry" />
        </mxCell>
        <mxCell id="fs12" value="猜想目标 Furstenberg Conjecture&#10;dim_H E ≥ min{s+t, (3s+t)/2, s+1}&#10;主情形 s &lt; t &lt; 2−s 长期开放&#10;（Wolff 网格构造显示该界尖锐）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="fs1">
          <mxGeometry x="430" y="40" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="fs13" value="历史进展（缺口在哪里）&#10;Bourgain 2003: s=t · Héra 等 2018: (s,2s)&#10;Lutz-Stull 2021: t ≤ s（界 s+t）&#10;此前一般下界仅 max(t/2+s, s+min(s,t))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="fs1">
          <mxGeometry x="875" y="40" width="500" height="95" as="geometry" />
        </mxCell>

        <mxCell id="fs2" value="证明框架 Proof Structure：离散化 → 分支函数分类 → 两条引理链 → 尺度归纳" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="210" width="1400" height="700" as="geometry" />
        </mxCell>
        <mxCell id="fs21" value="① 离散化 Discretization&#10;δ-管族 T 近似直线 ℓ（覆盖数 |T|_δ）&#10;(δ, s, δ^{-η})-nice 配置 (P, T)&#10;维数问题 → 管族体积估计问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="fs2">
          <mxGeometry x="30" y="40" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fs22" value="② 分类 Classification（分支函数）&#10;按各尺度分支行为分成两类：&#10;· 几乎 AD-正则（各尺度均匀分布）&#10;· 半良好间隔（某些尺度稀疏分布）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="fs2">
          <mxGeometry x="460" y="40" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fs23" value="③ 关键引理 Key Lemmas&#10;Roth 反推论证 · QP 覆盖引理&#10;和积估计（加性组合）&#10;尺度归纳引理（ε-改进迭代）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="fs2">
          <mxGeometry x="910" y="40" width="470" height="100" as="geometry" />
        </mxCell>

