        </mxCell>
        <mxCell id="sh6a3t" value="信道 · 被传输与被干扰的环境" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="sh6">
          <mxGeometry x="50" y="81" width="340" height="20" as="geometry" />
