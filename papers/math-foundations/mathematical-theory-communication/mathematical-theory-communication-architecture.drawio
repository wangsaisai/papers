          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se10" value="率失真（有损压缩）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;dashed=1;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sh34" target="sh51">
          <mxGeometry relative="1" as="geometry" />
