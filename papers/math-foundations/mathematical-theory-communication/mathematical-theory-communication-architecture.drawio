        <mxCell id="sh6a4t" value="信息度量 · 互信息 / 容量" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="sh6">
          <mxGeometry x="50" y="105" width="340" height="20" as="geometry" />
        </mxCell>
