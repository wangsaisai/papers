          <mxGeometry x="10" y="131" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sh6a5t" value="扩展（采样 / 率失真 / 分离）与边界" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="sh6">
          <mxGeometry x="50" y="129" width="340" height="20" as="geometry" />
        </mxCell>
