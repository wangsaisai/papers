        <mxCell id="slnote" value="结构规则：k 级节点拥有 k 个前向指针，同属第 1..k 层链表（如 30 横跨 L1·L2·L3）；&#10;每层链表跳过 2^{i−1} 个中间节点 → 查找步数从 O(n) 降到 O(log n)；链表以 NIL 哨兵终止" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fillColor=none;fontStyle=2;" vertex="1" parent="sl1">
          <mxGeometry x="130" y="390" width="880" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sl2" value="抛硬币建层级 · 核心操作 Random Levels &amp; Operations" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1070" y="20" width="350" height="480" as="geometry" />
        </mxCell>
        <mxCell id="slcoin" value="抛硬币建层级（晋升规则）&#10;新节点级别 = 连续晋升级数&#10;P(级别 ≥ k+1 | ≥ k) = p&#10;p = 1/2（方差小）或 p = 1/4（更省空间）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="sl2">
          <mxGeometry x="25" y="40" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="slsearch" value="查找 Search —— 从最高层下探&#10;在当前层横向右移，指针将越过目标&#10;时下移一层；到第 1 层定位目标或失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="sl2">
          <mxGeometry x="25" y="150" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="slinsert" value="插入 Insert&#10;搜索同时记录 update 向量（各级前驱）&#10;抛硬币生成级别 → 逐层拼接新节点&#10;必要时提升列表最大级别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="sl2">
          <mxGeometry x="25" y="260" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sldelete" value="删除 Delete&#10;搜索定位目标 → 各层重新链接&#10;前驱 → 后继；删除最大元素后&#10;降低列表最大级别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="sl2">
          <mxGeometry x="25" y="370" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sl3" value="理论保证 Theoretical Guarantees（概率平衡哲学）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="520" width="700" height="270" as="geometry" />
        </mxCell>
        <mxCell id="slg1" value="期望成本 Expected Cost&#10;期望搜索成本 ≤ L(n)/p + 1/(1−p) = O(log n)，L(n) = log_{1/p} n&#10;比较次数 = 搜索路径长度 + 1（反向爬升分析：C(k) = k/p）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="sl3">
          <mxGeometry x="25" y="40" width="650" height="75" as="geometry" />
        </mxCell>
        <mxCell id="slg2" value="高概率保证（非最坏情形）&#10;p = 1/2, n = 4096：搜索超期望 3 倍&#10;概率 &lt; 1/200,000,000&#10;n &gt; 250 时超 3 倍概率 &lt; 10^{-6}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="sl3">
          <mxGeometry x="25" y="130" width="310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="slg3" value="参数设计&#10;MaxLevel = L(N)（N 为元素数上界）&#10;p = 1/2, 2^16 元素 → MaxLevel = 16&#10;平均指针数 1/(1−p)：p = 1/4 时 ≈ 1.33&#10;级别生成平均需 (log₂ 1/p)/(1−p) 个随机位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="sl3">
          <mxGeometry x="365" y="130" width="310" height="100" as="geometry" />
        </mxCell>

        <mxCell id="sl4" value="实测对比与影响 Benchmarks &amp; Impact" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="520" width="680" height="270" as="geometry" />
        </mxCell>
        <mxCell id="slk1" value="实测（Sun-3/60 · 2^16 个整数）&#10;插入 0.065ms：比非递归 AVL 快 1.55×，比 2-3 树快 3.2×&#10;删除快 1.46× / 3.65× · 搜索速度与 AVL 相当" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="sl4">
          <mxGeometry x="25" y="40" width="630" height="80" as="geometry" />
        </mxCell>
        <mxCell id="slk2" value="应用 Applications&#10;Redis 有序集合 zset&#10;LevelDB / RocksDB MemTable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="sl4">
          <mxGeometry x="25" y="135" width="300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="slk3" value="局限 Limitations&#10;概率保证而非最坏情形保证&#10;键比较更多 · 需要高质量随机数&#10;64 位指针的空间开销较高" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="sl4">
          <mxGeometry x="355" y="135" width="300" height="95" as="geometry" />
        </mxCell>

