  <diagram name="MEA-Architecture" id="longhorizon-harness">
    <mxGraphModel dx="1440" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="原始任务 T&#xa;（需求 / 约束集合）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="3" value="账本：任务状态 S_i（跨轮持久）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
