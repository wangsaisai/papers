          <mxGeometry x="217" y="38" width="88" height="34" as="geometry" />
        </mxCell>
        <mxCell id="7" value="每条记录标记 completed / pending / blocked / untrusted。&#xa;只有被审计验证过的事实能改写账本；executor&#xa;的自我声明一律不算数" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;" vertex="1" parent="3">
          <mxGeometry x="15" y="80" width="290" height="62" as="geometry" />
        </mxCell>

        <mxCell id="8" value="审计报告库 V_i（跨轮唯一记忆）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1060" y="10" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="9" value="审计报告 v1 … vi，每份带独立证据链&#xa;（文件状态、屏幕截图、元数据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="15" y="38" width="350" height="100" as="geometry" />
        </mxCell>

        <mxCell id="10" value="LongHorizon-Harness · Manage-Execute-Audit（MEA）循环 — 每轮执行 ① ② ③，直至 done / blocked / ask / 轮次超限" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="240" width="1400" height="660" as="geometry" />
        </mxCell>

        <mxCell id="11" value="Manager 管理者 Φ&lt;sub&gt;mgr&lt;/sub&gt;（工头）&#xa;——不碰电脑，只读账本——&#xa;&#xa;审视：任务 T + 状态 S_i + 全部审计报告 V_i&#xa;决策：execute / done / blocked / ask&#xa;产出：子任务契约（目标、验收标准、&#xa;边界约束、相关既往证据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="10">
          <mxGeometry x="40" y="40" width="360" height="320" as="geometry" />
        </mxCell>

        <mxCell id="12" value="Executor 执行器 Φ&lt;sub&gt;exec&lt;/sub&gt;（工人）&#xa;全新上下文 · 预算受限的单轮 episode" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=10;" vertex="1" parent="10">
          <mxGeometry x="460" y="40" width="320" height="400" as="geometry" />
        </mxCell>
        <mxCell id="13" value="GUI 执行器&#xa;截图 / 点击 / 滚动 / 输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="30" y="90" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="14" value="CLI 执行器&#xa;shell / 编辑 / 写码 / 测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="30" y="200" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="15" value="轮毕即弃：episode 的原始轨迹与内部推理&#xa;全部丢弃，只把执行报告 o_i 交出去审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="30" y="310" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="16" value="计算环境 e_i&#xa;应用 / 窗口 / 文件 / 进程 / 系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="10">
          <mxGeometry x="840" y="40" width="250" height="200" as="geometry" />
        </mxCell>

        <mxCell id="17" value="Auditor 审计器 Φ&lt;sub&gt;aud&lt;/sub&gt;（质检员）&#xa;——只读权限，独立核查——&#xa;&#xa;对照契约重新现场：&#xa;完成没有？越界没有？&#xa;有没有破坏别的东西？&#xa;&#xa;产出：审计报告 v_i（带证据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="10">
