        <mxCell id="25" value="评测" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=0.8;entryY=0;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
