        <mxCell id="24" value="部署" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="5" target="7">
          <mxGeometry relative="1" as="geometry" />
