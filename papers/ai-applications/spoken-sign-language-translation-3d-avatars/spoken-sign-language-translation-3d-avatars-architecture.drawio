        <mxCell id="2" value="① 词典构建（离线 · Dictionary Construction）" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1400" height="240" as="geometry" />
        </mxCell>
        <mxCell id="3" value="连续手语视频数据集&#xa;Phoenix-2014T（德语·1066 gloss）&#xa;CSL-Daily（中文·2000 gloss）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="30" y="50" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="4" value="TwoStream-SLR 手语分割器&#xa;（CSLR 模型 · CTC 损失 + DTW 最优对齐&#xa;· 分割孤立手势 / 生成协同发音过渡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="380" y="50" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="5" value="手势-视频词典&#xa;M 个手势标注 × 多个孤立手势视频" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="730" y="50" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="6" value="SMPLSign-X 3D 手势估算（SMPLify-X 手语专用改进）&#xa;HRNet 2D 关键点（伪标注/置信度）→ 优化形状β·姿态θ·表情ψ·方向ζ&#10;新增损失：L_unseen（未见关节回正）· L_upright（上半身直立）· L_smooth（时间平滑）&#10;产出：手势-3D 手势词典（SMPL-X 参数）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="1070" y="50" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="10" value="② 在线翻译（Text2Gloss + 手势检索）" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="800" height="230" as="geometry" />
        </mxCell>
        <mxCell id="11" value="输入文本（口语）&#xa;例：“风很大”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="10">
          <mxGeometry x="30" y="50" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="12" value="mBART Text2Gloss 翻译器&#xa;文本 → 手势标注序列（gloss sequence）&#xa;例：Wind / Strong / Blow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="10">
          <mxGeometry x="30" y="140" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="13" value="手势检索（Sign Retrieval）&#xa;训练 ISLR 模型，从词典中为每个 gloss&#xa;选出置信度最高的 3D 手势" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="10">
          <mxGeometry x="420" y="50" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" value="3D 手势序列 {S₁, S₂, …, S_K}&#xa;（SMPL-X 参数驱动 · 可任意旋转视角）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="10">
          <mxGeometry x="420" y="140" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="20" value="③ 连接与渲染（手语连接器 → 3D 虚拟角色）" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="860" y="300" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="21" value="手语连接器（Sign Connector）&#xa;4 层 MLP：输入前后手势 3D 关节 + 坐标距离，&#xa;预测协同发音持续时间 L̂（L1 损失训练）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="20">
          <mxGeometry x="30" y="45" width="490" height="55" as="geometry" />
