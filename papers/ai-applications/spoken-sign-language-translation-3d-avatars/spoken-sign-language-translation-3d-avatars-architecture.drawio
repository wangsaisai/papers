        <mxCell id="22" value="参数空间插值生成协同发音 C（过渡动作，&#10;拼成含过渡的完整序列 {S1, C1², S2, …}）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="20">
          <mxGeometry x="30" y="115" width="490" height="50" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Blender 渲染 3D 手语虚拟角色动画&#xa;（SMP-X 姿态 + 表情参数驱动 · 多视角可看）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="20">
          <mxGeometry x="30" y="175" width="490" height="45" as="geometry" />
