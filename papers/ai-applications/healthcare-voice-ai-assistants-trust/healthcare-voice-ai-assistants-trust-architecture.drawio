        </mxCell>
        <mxCell id="3" value="问卷设计&#xa;13 个因素条目 · 5 点李克特量表&#xa;两次试点（各 30 人）后定稿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="2">
