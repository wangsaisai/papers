<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Memcache-Architecture" id="scaling-memcache-facebook">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="Web 服务器（客户端中心）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Web 服务器（渲染页面）&#10;单个页面平均取 521 个条目（大扇出）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="60" y="55" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="memcache 客户端（无状态）&#10;· DAG 依赖批处理（平均 24 键/批）&#10;· UDP get（延迟-20%）· TCP set/delete&#10;· 序列化/压缩/路由/错误处理&#10;（嵌入库 或 mcrouter 独立代理）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="420" y="55" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="旁路缓存（look-aside）：&#10;读：先查缓存，未命中查库并回填&#10;写：只删缓存（删除幂等），下次读自然刷新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="920" y="55" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="6" value="集群内（In a Cluster）—— memcache 服务器池" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1360" height="300" as="geometry" />
        </mxCell>
        <mxCell id="7" value="memcached 服务器 × 数百&#10;一致性哈希分布 · 内存哈希表&#10;服务器间不互通信 —— 只负责快" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="6">
          <mxGeometry x="60" y="60" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="8" value="租约（Leases）&#10;未命中发 64 位令牌，持令牌才能回填；&#10;DB 查询峰值 17K/s → 1.3K/s（-92%）&#10;支持返回过期值（还真可选）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="6">
          <mxGeometry x="540" y="60" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Gutter 容错池（1% 备用服务器）&#10;故障请求转'替补席' 不直穿 DB，&#10;消除 99% 客户端可见故障" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="6">
          <mxGeometry x="540" y="180" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="10" value="单服务器优化&#10;· 细粒度锁（60 万→180 万条目/秒）&#10;· 自适应 slab 分配器 &#10;· 临时条目缓存（6%→0.3% 内存）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="6">
          <mxGeometry x="860" y="60" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="11" value="区域内失效与全局架构（In a Region / Across Regions）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="12" value="MySQL 数据库（读源）&#10;主 / 从复制：供各集群读副本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="11">
          <mxGeometry x="60" y="60" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="13" value="mcsqueal 守护进程&#10;解析 DB 变更日志 → 批处理后广播失效（每包 18× 删除量）、区级广播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="11">
          <mxGeometry x="420" y="60" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="14" value="区域（Region）&#10;主区域：数据流源头&#10;副本区域：跟随同步、可收发写请求（本地队列）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="11">
          <mxGeometry x="900" y="60" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="15" value="远程标记（Remote Markers）&#10;数据库复制延迟 → 副本区不立即删缓存，&#10;标记后延迟失效，消除“读旧新”坑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="11">
          <mxGeometry x="900" y="240" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="16" value="冷集群预热：回放 DB 更新日志填充缓存 → 恢复从天→小时" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;" vertex="1" parent="11">
          <mxGeometry x="420" y="235" width="380" height="40" as="geometry" />
        </mxCell>

        <mxCell id="18" value="get/set/delete（UDP·TCP 批处理）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" value="并发取 521 条目" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" value="未命中查询 DB，命中返回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="写路径：SQL → DB + 删除缓存" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" value="失效广播" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" value="减速（DB binlog 复制）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>