<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="CFS-Architecture" id="cfs-scaling-metadata-service">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="客户端接入（无独立代理层 —— 解析逻辑下沉到客户端库）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="3" value="应用程序（POSIX 接口）&#10;getattr / create / mkdir / rename / read / write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="60" y="55" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="VFS 适配器（内核）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="380" y="55" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="ClientLib（客户端元数据解析）&#10;缓存 TafDB / FileStore 分区信息，&#10;自己直接路由到对应分片 —— 无代理中转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="600" y="55" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="局限：分区缓存需与集群规模变化同步；&#10;跨数据中心时客户端复杂度与一致性风险上升" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="1030" y="55" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="7" value="元数据服务 · 分层组织（Hierarchical Metadata Organization）&#10;—— 目录结构保局部性 / 文件属性保负载均衡 ——" style="swimlane;startSize=42;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1360" height="540" as="geometry" />
        </mxCell>

        <mxCell id="8" value="FileStore 文件存储层&#10;（文件属性 + 数据块）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="7">
          <mxGeometry x="60" y="70" width="360" height="330" as="geometry" />
        </mxCell>
        <mxCell id="9" value="本地 RocksDB：&#10;文件属性 KV（inode id → 属性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="25" y="55" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="10" value="文件数据块（与属性同节点）&#10;三路复制 + 元数据 WAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="25" y="145" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="11" value="哈希分区（按文件 id 散列）&#10;→ 天然负载均衡，大目录不热点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="25" y="235" width="310" height="75" as="geometry" />
        </mxCell>

        <mxCell id="12" value="TafDB 命名空间存储层（目录结构）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="7">
          <mxGeometry x="500" y="70" width="560" height="430" as="geometry" />
        </mxCell>
        <mxCell id="13" value="时间戳服务器（TS）&#10;分配单调递增时间戳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="25" y="55" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="14" value="后端服务器（BE）× N&#10;Raft 复制组 · WAL 持久化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="295" y="55" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="15" value="inode_table 统一大表&#10;范围分区（按父 inode id）：&#10;目录属性 + 子文件 id 同片共置 → 局部性，&#10;创建文件无需分布式事务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="25" y="150" width="510" height="105" as="geometry" />
        </mxCell>
        <mxCell id="16" value="单分片原子原语（一条命令完成）&#10;insert_with_update / delete_with_update /&#10;insert_and_delete_with_update&#10;→ 读+条件检查+变更一次执行，锁持极短" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="25" y="280" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="17" value="冲突调解（去掉伪锁）&#10;· children/links/size：增量累加可合并&#10;· mtime/权限：最后写入者胜&#10;→ 并发 create 无需锁父目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="12">
          <mxGeometry x="295" y="280" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="18" value="Renamer 重命名服务&#10;（Raft 协调器）&#10;正常路径（约 1% 跨目录）&#10;传统锁 + 两阶段提交&#10;防孤儿环路" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="7">
          <mxGeometry x="1120" y="70" width="270" height="240" as="geometry" />
        </mxCell>
        <mxCell id="19" value="同目录重命名走快速路径：&#10;ClientLib 直连 TafDB 单分片原语" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="18">
          <mxGeometry x="20" y="150" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="20" value="后台垃圾回收（GC）&#10;定期清理 FileStore 中&#10;无 inode 引用的孤立属性记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="7">
          <mxGeometry x="1120" y="350" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="21" value="确定性执行顺序（消除分布式事务）&#10;create：先 FileStore 后 TafDB&#10;delete：先 TafDB 后 FileStore&#10;→ 崩溃最坏只是出现孤立属性，对外不可见，由 GC 回收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="7">
          <mxGeometry x="60" y="430" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="22" value="POSIX 调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" value="文件/元数据操作" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="24" value="文件属性 / 数据请求（getattr、read、write）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25" value="目录/命名空间请求（create、unlink、mkdir）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="26" value="复杂重命名（正常路径）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" value="create 顺序：先属性后索引" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#82b366;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="28" value="读/写 TafDB 与 FileStore（协调执行）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="18" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="29" value="回收孤立属性" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>