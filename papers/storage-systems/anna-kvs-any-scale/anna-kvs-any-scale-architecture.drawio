          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="34" value="周期性异步多播（~100ms）&#10;不在请求关键路径上，跨线程共享内存 / 跨服务器网络 protobuf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#d79b00;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="14">
