<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Anna-Architecture" id="anna-kvs-any-scale">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="客户端接入层（Client Access）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="3" value="应用程序客户端（Client App）&#10;put / get 请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="2">
          <mxGeometry x="60" y="55" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="客户端代理（Client Proxy）&#10;负载均衡 · 请求缓冲/缓存&#10;（读已提交等一致性在代理侧实现）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="360" y="55" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="一致性哈希路由（Consistent&#10;Hashing）&#10;把键空间分片到参与者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="710" y="55" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="多主复制（Multi-master）&#10;可调复制因子 Rep=1…全复制&#10;每个副本都可读写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="1040" y="55" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="7" value="服务器 · 无协调参与者层（Coordination-free Actor Layer）&#10;——每个 CPU 核心一个参与者线程（1:1 绑定，无锁 · 无原子指令 · 无共享内存）——" style="swimlane;startSize=42;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1360" height="460" as="geometry" />
        </mxCell>
        <mxCell id="8" value="参与者 A（Actor · 线程1）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="7">
          <mxGeometry x="60" y="75" width="400" height="350" as="geometry" />
        </mxCell>
        <mxCell id="9" value="输入队列&#10;（客户端请求&#10;+ 核心间消息）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="25" y="60" width="155" height="70" as="geometry" />
        </mxCell>
        <mxCell id="10" value="无等待事件循环&#10;处理 put/get" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="200" y="60" width="185" height="70" as="geometry" />
        </mxCell>
        <mxCell id="11" value="私有哈希表（Private State）&#10;格值映射 MapLattice&#10;——线程独占，不共享" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="25" y="170" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="12" value="变更集（Changeset）&#10;累积本周期更新的&#10;键值对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="215" y="170" width="170" height="95" as="geometry" />
        </mxCell>
        <mxCell id="13" value="发送端合并（merge-at-sender）：&#10;利用格结合律，周期内同一键的&#10;多次更新合并为一条再发送" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="25" y="285" width="360" height="55" as="geometry" />
        </mxCell>

        <mxCell id="14" value="参与者（Actor）· 线程2&#10;（同构：键分区副本 B）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="7">
          <mxGeometry x="520" y="75" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="15" value="参与者（Actor）· 线程3 … N&#10;（同构；跨服务器时经网络&#10;protobuf 通信，扩展至多节点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="7">
          <mxGeometry x="980" y="75" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="16" value="（其余参与者结构相同：事件循环 + 私有格状态 + 变更集）" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;" vertex="1" parent="7">
          <mxGeometry x="530" y="200" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="17" value="低冲突+高复制时 gossip 占比升至 69% CPU → 复制因子需按键动态调整（论文留有未完成工作）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="7">
          <mxGeometry x="980" y="210" width="380" height="60" as="geometry" />
        </mxCell>
        <mxCell id="18" value="弹性扩容：运行时加入/移除参与者线程（块区迁移由一致性哈希保证）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="7">
          <mxGeometry x="530" y="245" width="390" height="55" as="geometry" />
        </mxCell>

        <mxCell id="19" value="格构建块（Lattice Building Blocks，ACI：结合·交换·幂等）" style="swimlane;startSize=34;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="1360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="20" value="MaxIntLattice&#10;单调计数 / 时间戳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="19">
          <mxGeometry x="70" y="70" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="21" value="MapLattice&#10;键 → 值格（哈希映射）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="19">
          <mxGeometry x="290" y="70" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="22" value="PairLattice&#10;向量时钟 / 事务&#10;（字典序合并）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="19">
          <mxGeometry x="510" y="70" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="23" value="ValueLattice&#10;应用自定义合并逻辑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="19">
          <mxGeometry x="730" y="70" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="24" value="简单最终一致性 / 因果一致性 / 读已提交 / 读未提交 / 项截断隔离…&#10;每种一致性级别仅需修改 ≤60 行代码（模块化设计，防范 CACE）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="19">
          <mxGeometry x="980" y="60" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="25" value="局限：不能提供线性化 / 可串行化（强一致性场景不适用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="19">
          <mxGeometry x="985" y="160" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="26" value="put/get 请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
