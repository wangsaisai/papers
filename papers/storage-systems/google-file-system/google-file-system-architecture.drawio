<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="GFS-Architecture" id="google-file-system">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="客户端层（Client Layer）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="3" value="应用（MapReduce / 大规模数据密集任务）&#10;—— 大文件 · 追加为主（追加:覆盖 ≈ 108:1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="60" y="55" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="GFS 客户端库&#10;（文件名 → Chunk 句柄/位置寻址 · 缓存元数据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="480" y="55" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="设计前提：廉价商用硬件 · 组件失效为常态 · 不迁移 POSIX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="2">
          <mxGeometry x="920" y="55" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="6" value="元数据层 —— Master（单一主控，不参与数据路径）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="1360" height="260" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Master&#10;· 命名空间 / 文件→Chunk 映射 / ChunkServer 位置&#10;· Chunk 租约（Lease）颁发 · 副本托管&#10;· 垃圾回收（惰性：改名隐藏+后台清理）&#10;· Chunk 再平衡 / 调度 · 心跳收集状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="6">
          <mxGeometry x="60" y="60" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="8" value="影子 Master（Shadow）&#10;只读镜像，提供故障期间读高可用；&#10;写元数据仍单点（局限：Master 挂则写不可用）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="6">
          <mxGeometry x="560" y="60" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="9" value="运维对齐：&#10;· 启动/心跳握手重连 · 名字服务器归属" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;" vertex="1" parent="6">
          <mxGeometry x="900" y="60" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="10" value="存储层 —— ChunkServer × 数百（廉价机 · 跨机架）" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1360" height="400" as="geometry" />
        </mxCell>
        <mxCell id="11" value="ChunkServer N（同构 × 数百）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="10">
          <mxGeometry x="60" y="70" width="620" height="290" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Chunk（64MB）× 三个副本&#10;（Primary 主 + Secondary 副）&#10;副本跨机架放置 · 每机架多份副本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="11">
          <mxGeometry x="25" y="55" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="13" value="原子记录追加（Atomic Record Append）&#10;多客户端并发追加到同一文件尾：&#10;由 Primary 定序，无锁并发（“意见箱”比喻）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="11">
          <mxGeometry x="330" y="55" width="265" height="100" as="geometry" />
        </mxCell>
        <mxCell id="14" value="数据安全（每 64KB 块 32 位校验和）· Chunk 版本号&#10;读/校验失败 → 报告 Master → 强制重复制 · 惰性恢复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="11">
          <mxGeometry x="25" y="175" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="15" value="写流程（Lease 定序）&#10;① 询问 Master 主副本与租约 → ② 数据流推向全部副本（链式管道）→ ③ 主副本定序并写入 → ④ 副副本顺序执行 → ⑤ 回 ACK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="11">
          <mxGeometry x="330" y="175" width="265" height="85" as="geometry" />
        </mxCell>
        <mxCell id="15b" value="读流程：客户端从 Master 拿到 Chunk 位置 → 数据直连 ChunkServer（数据路径不经过 Master）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="10">
          <mxGeometry x="740" y="70" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="16" value="复制 ↔ 恢复：3 副本 → 少副本即时重建（约 440MB/s）· 均衡迁移规避热点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="10">
          <mxGeometry x="740" y="150" width="620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="17" value="线路：全机架交换机 · 名称：机架感知副本放置" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=none;" vertex="1" parent="10">
          <mxGeometry x="740" y="240" width="620" height="40" as="geometry" />
        </mxCell>

        <mxCell id="18" value="元数据（文件名 → Chunk 位置）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" value="询问 / 缓存失效" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" value="心跳 + 每 Chunk 状态 + 租约请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="数据直连接（读）+ 控制流（写租约）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>