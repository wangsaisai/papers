<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="SpanDB-Architecture" id="span-db">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="应用 / KV 客户端&#10;写（put）· 读（get）· 扫描" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="3" value="异步请求处理（Async Request Processing）&#10;写流水线三段：准备日志 Q_ProLog → 写日志 Q_Log → 更新内存表 Q_Epilog&#10;（另有 Q_Read / Q_Flush / Q_Compact 任务队列）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="30" width="1040" height="150" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Q_ProLog&#10;准备日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="30" y="60" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Q_Log&#10;并行 WAL 日志器 ×1~3&#10;（每个可流水线处理多请求）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="260" y="60" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Q_Epilog&#10;更新 MemTable&#10;（可变 + 不可变）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="520" y="60" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Q_Read / Q_Flush / Q_Compact&#10;读请求 · 刷盘 · 压缩任务（后台限流：&#10;I/O 请求 1MB→64KB，限制线程数）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="3">
          <mxGeometry x="770" y="60" width="250" height="70" as="geometry" />
        </mxCell>

        <mxCell id="8" value="混合存储（Hybrid Storage）—— 好钢用在刀刃上" style="swimlane;startSize=32;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1360" height="430" as="geometry" />
        </mxCell>
        <mxCell id="9" value="SD 速度盘（小 · 快 · 贵，如 Optane）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="8">
          <mxGeometry x="60" y="70" width="620" height="260" as="geometry" />
        </mxCell>
        <mxCell id="10" value="WAL 专属区（原始设备，SPDK 直接驱动）&#10;专用 NVMe 队列 · WAL 优先保障" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="9">
          <mxGeometry x="25" y="55" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="11" value="TopFS 轻量文件系统（SPDK 之上）&#10;利用 SST“一次写不可改”简化设计&#10;自带缓存复用 SPDK 锁定内存缓冲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="9">
          <mxGeometry x="325" y="55" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="12" value="LSM 顶层（热数据：L0…L 热）&#10;所有刷新（MemTable → L0 SST）落 SD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="9">
          <mxGeometry x="25" y="165" width="570" height="75" as="geometry" />
        </mxCell>
        <mxCell id="13" value="SPDK（用户态轮询 I/O）&#10;· 独占设备 · 绕过内核/中断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="9">
          <mxGeometry x="25" y="260" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" value="CD 容量盘（大 · 慢 · 便宜，普通 NVMe）&#10;LSM 底层（冷数据“树桩”，占大多数）&#10;走文件系统（ext4）+ OS 页面缓存" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;verticalAlign=top;align=center;paddingTop=8;" vertex="1" parent="8">
          <mxGeometry x="760" y="70" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="15" value="LSM 底层（冷数据）&#10;压缩 / 读命中交汇处" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="14">
          <mxGeometry x="25" y="55" width="510" height="75" as="geometry" />
        </mxCell>
        <mxCell id="16" value="动态层级放置（自适应）&#10;监控两盘实时带宽：&#10;写多 → SD 纯日志模式&#10;读多 → SD 也放热数据（TopFS 承载）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="760" y="290" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="17" value="收益：全写 +7.6~8.8 倍（YCSB）；YCSB-A +2.6~4.0 倍；&#10;P90/P99 尾延迟 -1.4~2.6 倍；成本约为全高端部署的 1/4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="8">
          <mxGeometry x="60" y="355" width="1260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="18" value="局限：SPDK 独占设备无法多实例共享；全读无加速；CPU 轮询能耗高（94.5% vs 63.7%）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="19" value="写请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" value="WAL 并行写入（快速路径）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="MemTable → L0 刷新（Flush）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" value="SST 层级放置（热上冷下）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" value="读路径：MemTable → SD 顶层 → CD 底层（合并视图）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>