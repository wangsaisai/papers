<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="TAO-Architecture" id="tao-facebook-distributed-data-store">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="客户端：Facebook 应用服务器 / 页面渲染&#10;单页需数百条对象+关联查询 · 细粒度隐私过滤&#10;读：写 ≈ 99.8% : 0.2% · 热门条目附客户端侧小缓存（带版本号）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="3" value="主区域（Master Region）——写入的归宿" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="180" width="720" height="820" as="geometry" />
        </mxCell>
        <mxCell id="4" value="追随者层 Follower Tier（每区 ≥2 层：主 / 备用故障转移）&#10;缓存对象 + 关联列表 + 关联计数 · 语义感知查询&#10;（负条目、零计数也能回答）· 读命中直接应答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="3">
          <mxGeometry x="60" y="100" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="5" value="领导者层 Leader Tier（单层 · 一致性协调者）&#10;串行化并发写 · 防数据库惊群 · 对挂起查询限流&#10;写库并导出 失效（invalidate）+ 补全（refill）消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="3">
          <mxGeometry x="60" y="300" width="620" height="140" as="geometry" />
        </mxCell>
        <mxCell id="6" value="MySQL 主库（存储层 · 一致的真值来源）&#10;分片→逻辑库：对象表 / 关联表 / 关联计数表&#10;原子写事务 · 反向关联写跨两分片（异步修复悬挂关联）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="3">
          <mxGeometry x="60" y="500" width="620" height="150" as="geometry" />
        </mxCell>

        <mxCell id="10" value="从区域（Replica Region，跨国距数千英里）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="180" width="660" height="820" as="geometry" />
        </mxCell>
        <mxCell id="11" value="追随者层 Follower Tier&#10;面向本地客户端 · 读命中本地应答&#10;未命中 / 写请求转发本区领导者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="10">
          <mxGeometry x="50" y="100" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="12" value="区领导者层（本地协调者）&#10;读未命中查询本地从库 · 转发写入发往主区领导者&#10;按复制流投递失效 / 补全消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="10">
          <mxGeometry x="50" y="470" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="13" value="MySQL 从库（完整图谱的完整副本）&#10;异步复制 · 故障时自动提升为新的主库&#10;从库宕机：主库 binlog tailer 跨区投递消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;spacingLeft=8;" vertex="1" parent="10">
          <mxGeometry x="50" y="650" width="560" height="140" as="geometry" />
        </mxCell>

        <mxCell id="20" value="数据模型 · 一致性 · 热点优化" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="1040" width="1400" height="400" as="geometry" />
        </mxCell>
        <mxCell id="21" value="数据模型：Object（64-bit id）+ Association（有向边,time,data）&#10;关联列表 (id1, atype) → [new…old] 按时间降序&#10;反向边类型自动维护 · 时间字段支撑（时间范围查询）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="20">
          <mxGeometry x="60" y="115" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="22" value="固定查询集：&#10;object get / partial update&#10;assoc get / count / range / time-range&#10;每 atype 上限 6000 条 · 无通用图分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="20">
          <mxGeometry x="410" y="115" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="23" value="一致性：最终一致 + 正常小幅写后读&#10;版本号解决顺竞 · 关键读（认证等）代理到主区&#10;故障转移尽力而为（可牺牲 写后读）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="20">
          <mxGeometry x="760" y="115" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="24" value="热点优化：&#10;分片克隆（clone shard→多追随者托管）&#10;客户端小缓存（频率超阈值附版本号）&#10;高 connect 数对象用反向边 / 时间象限缩小" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="20">
          <mxGeometry x="1110" y="115" width="310" height="180" as="geometry" />
        </mxCell>
        <mxCell id="25" value="生产指标：10 亿读 / s 以上 · 数百万写 / s · 缓存命中率 96.4% · 中位延迟 1.0–1.3ms（命中）5–8ms（未命中）· 复制延迟 85%情况下 &lt;1s · 可用性 ≈ 99.9995%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="20">
          <mxGeometry x="60" y="315" width="1320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="30" value="本地查询（读写后结果快）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" value="读未命中 / 写转发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="32" value="读写探查（串行化）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="33" value="变更集 / 失效+补全（异步）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="34" value="数据库复制流（binlog）·内嵌失效+补全消息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;dashed=1;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="35" value="跨区域写转发（释放写入）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="36" value="读未命中 / 写转发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="37" value="本地读" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="38" value="本地区查询（命中 / 未命中）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>