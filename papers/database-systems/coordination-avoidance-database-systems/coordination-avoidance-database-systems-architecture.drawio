<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="I-Confluence-Framework" id="coordination-avoidance-database-systems">
    <mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="应用不变式 I（正确性标准）&#10;SQL DDL 约束：主键 / 唯一 / 外键 / 检查&#10;物化视图一致性 · 数据类阈值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="3" value="事务集 T（存储过程）&#10;插入 / 删除 / 更新 / 递增·递减&#10;读取与删除往往可无协调执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1020" y="30" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="4" value="I-合流静态分析（按判定表逐对检查）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#505050;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="1360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="5" value="分析流程&#10;① 从 SQL DDL + 存储过程提取不变式与事务&#10;② 对每个 &lt;不变式, 操作&gt; 组合查判定表&#10;③ 标记 safe / unsafe；未识别的组合保守标记" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="4">
          <mxGeometry x="70" y="60" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="6" value="判定表样例（表2）&#10;唯一·选特定值 ✗  |  唯一·选某值 ✓&#10;外键·插入 ✓  |  外键·删除 ✗  |  外键·级联删除 ✓&#10;物化视图·更新 ✓  |  计数器递增(阈值&gt;) ✓&#10;递减(阈值&lt;) ✓  |  AUTO_INCREMENT·插入 ✗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="4">
          <mxGeometry x="610" y="60" width="740" height="90" as="geometry" />
        </mxCell>

        <mxCell id="7" value="判定：&#10;T 关于 I 是否 I-合流？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="8" value="无协调执行路径（I-合流 ⟹ 安全）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=center;fontStyle=1;fontSize=13;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="620" height="420" as="geometry" />
        </mxCell>
        <mxCell id="9" value="① 事务在本地副本（快照）上独立执行并本地提交——无跨服务器阻塞通信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="8">
          <mxGeometry x="70" y="90" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="10" value="② 合并算子（可交换·可结合·幂等）异步集成各副本状态&#10;（版本集合之并∪ / 计数器等 ADT 合并）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="8">
          <mxGeometry x="70" y="170" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="11" value="③ 保证：收敛 — 无新写入时副本最终同态；&#10;全局有效 — 合并所得状态仍满足不变式 I" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="8">
          <mxGeometry x="70" y="250" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12" value="例：RAMP 事务（多版本 + 元数据）保证原子可见，&#10;无协调即可维护外键约束与物化视图不变式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="8">
          <mxGeometry x="70" y="340" width="560" height="60" as="geometry" />
        </mxCell>

        <mxCell id="14" value="需要协调路径（非 I-合流）" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=center;fontStyle=1;fontSize=13;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="590" width="640" height="420" as="geometry" />
        </mxCell>
        <mxCell id="15" value="回退到可序列化隔离（2PL / 锁 / 两阶段提交），&#10;对“真正的”冲突读写进行协调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="14">
          <mxGeometry x="70" y="90" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="16" value="典型例：顺序 ID 分配不变式（AUTO_INCREMENT）——&#10;并发插入必须协调才能保证全局唯一" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="14">
          <mxGeometry x="70" y="170" width="540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="17" value="削减协调的设计技巧：&#10;事务先用匿名唯一 ID（tmpID）无协调执行，&#10;提交瞬间原子分配真实 ID 并登记映射表——&#10;所有协调收窄到单一服务器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="14">
          <mxGeometry x="70" y="250" width="540" height="120" as="geometry" />
        </mxCell>

        <mxCell id="20" value="定理 1（必要且充分）&#10;全局 I-有效的系统能以「无协调 + 事务可用 + 收敛」执行 T，当且仅当 T 关于 I 是 I-合流的&#10;——此前仅有充分条件（交换性 / 单调性），本框架首次给出“紧”条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="1360" height="130" as="geometry" />
        </mxCell>

        <mxCell id="21" value="TPC-C 案例验证" style="container=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5e1;strokeColor=#82b366;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=13;paddingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1270" width="1360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="22" value="12 个一致条件中 10 个是 I-合流的&#10;（物化视图维护 7 + 外键约束 3）&#10;仅 2 个需协调：顺序 ID 分配（New-Order / Delivery）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="21">
          <mxGeometry x="80" y="70" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="23" value="性能（200 台服务器）&#10;1274 万 txn/s —— 较可序列化提升 25×&#10;吞吐随客户端数线性扩展（2PL 在 4 万/s 饱和）&#10;协调开销占比仅 0.19%（ID 分配自旋锁）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="21">
          <mxGeometry x="520" y="70" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="24" value="瓶颈：物理资源（CPU/GC）而非逻辑争用&#10;OLTP-Bench：14 个应用中 9 个无完整性约束、&#10;2 个需可序列化隔离，其余均可无协调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="21">
          <mxGeometry x="960" y="70" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="30" value="不变式与事务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" value="事务集" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1176" y="186" />
              <mxPoint x="1022" y="186" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="32" value="分析结果（每对 safe / unsafe）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="33" value="是（safe）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="34" value="否（unsafe）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="35" value="证明可行性" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="36" value="识别必须同步之处" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
