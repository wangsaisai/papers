<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="mask-rcnn-architecture" name="Mask R-CNN Architecture">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="输入图像&#xa;Input Image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="40" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="卷积骨干 + 特征金字塔 · FPN Backbone&#xa;从整图提取多尺度特征" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="120" y="140" width="490" height="210" as="geometry" />
        </mxCell>
        <mxCell id="4" value="自底向上路径 + 自顶向下 + 侧向连接&#xa;Bottom-up Path with Top-down &amp; Lateral Connections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="3">
          <mxGeometry x="20" y="45" width="450" height="64" as="geometry" />
        </mxCell>
        <mxCell id="5" value="多尺度特征金字塔&#xa;Multi-Scale Feature Pyramid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="3">
          <mxGeometry x="20" y="120" width="450" height="64" as="geometry" />
        </mxCell>
        <mxCell id="6" value="RPN 区域候选网络&#xa;Region Proposal Network (anchors 5 尺度 × 3 宽高比)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="410" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="7" value="RoIAlign 兴趣区域对齐&#xa;不取整 x/16 · 每 bin 4 点双线性插值 (关键算子)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="535" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="8" value="网络头 Head · 每个 RoI 上并行三条分支&#xa;与 Faster R-CNN 相同的两阶段结构" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="120" y="690" width="490" height="280" as="geometry" />
        </mxCell>
        <mxCell id="9" value="分类分支 Class Branch&#xa;全连接 + softmax&#xa;类别标签" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="8">
          <mxGeometry x="20" y="45" width="140" height="190" as="geometry" />
        </mxCell>
        <mxCell id="10" value="框回归分支 Box Regression&#xa;全连接&#xa;边框偏移 (x, y, w, h)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="8">
          <mxGeometry x="175" y="45" width="140" height="190" as="geometry" />
        </mxCell>
        <mxCell id="11" value="掩码分支 Mask Branch&#xa;全卷积 FCN&#xa;3×3 卷积 + 2×2 反卷积&#xa;28×28 二值掩码 · 逐像素 sigmoid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="8">
          <mxGeometry x="330" y="45" width="140" height="190" as="geometry" />
        </mxCell>
        <mxCell id="12" value="输出 Outputs&#xa;检测: 类别 + 边框 (经 NMS)&#xa;分割: m×m 实例掩码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="1030" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="16" value="RoIPool vs RoIAlign 对比 (论文图 3)&#xa;ROI 特征提取算子" style="swimlane;startSize=32;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="700" y="535" width="480" height="290" as="geometry" />
        </mxCell>
        <mxCell id="17" value="RoIPool (旧算子)&#xa;坐标取整 [x/16]&#xa;边界取整 + 分箱取整&#xa;→ 特征与输入错位&#xa;(分类健壮, 掩码受损)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#8a8a8a;fontColor=#555555;fontSize=11;verticalAlign=middle;" vertex="1" parent="16">
          <mxGeometry x="20" y="45" width="210" height="200" as="geometry" />
        </mxCell>
        <mxCell id="18" value="RoIAlign (本论文)&#xa;不取整 x/16&#xa;每 bin 均匀采 4 点&#xa;双线性插值 + max/avg 聚合&#xa;→ 像素级精确对齐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="16">
          <mxGeometry x="250" y="45" width="210" height="200" as="geometry" />
        </mxCell>
