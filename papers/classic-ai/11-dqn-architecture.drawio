  <diagram name="DQN-Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="10" value="Atari 模拟器 (ALE)&#xa;环境 / Environment E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="原始帧 / Raw Frame&#xa;x_t (210×160 RGB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="预处理 φ / Preprocessing&#xa;灰度化→下采样 110×84→裁剪 84×84;&#xa;最近 4 帧堆叠 (84×84×4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="550" y="60" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="14" value="Q 网络 / Q-Network (CNN)" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="960" height="230" as="geometry" />
        </mxCell>
        <mxCell id="30" value="卷积层 1 / Conv Layer 1&#xa;16 个 8×8 卷积核, 步长 4, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="14">
          <mxGeometry x="30" y="60" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="31" value="卷积层 2 / Conv Layer 2&#xa;32 个 4×4 卷积核, 步长 2, ReLU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="14">
          <mxGeometry x="270" y="60" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="32" value="全连接层 / FC Layer&#xa;256 个 ReLU 单元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="14">
          <mxGeometry x="510" y="60" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="33" value="输出层 / Output Layer&#xa;线性层, 每个合法动作一个输出 (4~18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="14">
          <mxGeometry x="750" y="60" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="15" value="ε-贪心动作选择 / ε-greedy Selection&#xa;以 1−ε 选 max Q, 以 ε 随机; ε 从 1 退火到 0.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1140" y="270" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="16" value="执行动作 / Execute Action&#xa;a_t → 模拟器; 奖励截断为 ±1 (reward clipping)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1420" y="270" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="17" value="经验回放记忆 / Replay Memory D&#xa;存最近 100 万帧转移样本 (φ, a, r, φ′)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1140" y="510" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="18" value="小批量采样 / Minibatch&#xa;从 D 均匀随机抽取 32 条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1430" y="510" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="19" value="目标网络 / Target Network&#xa;y = r + γ·max_a′ Q(φ′,a′;θ)&#xa;(θ 取上一轮固定参数; 终态时 y = r)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1140" y="680" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="40" value="损失与梯度更新 / Loss &amp; Gradient Update&#xa;L = (y − Q(φ,a;θ))²; SGD (RMSProp, 批量 32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1430" y="680" width="200" height="90" as="geometry" />
