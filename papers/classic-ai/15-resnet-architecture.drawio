<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="ResNet-Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="残差块 Building Block&#xa;y = F(x, {Wᵢ}) + x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="780" height="500" as="geometry" />
        </mxCell>
        <mxCell id="3" value="输入 x&#xa;Input x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="2">
          <mxGeometry x="60" y="50" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="4" value="3×3 卷积 + BN + ReLU&#xa;Weight Layer（W1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="2">
          <mxGeometry x="280" y="50" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5" value="3×3 卷积 + BN&#xa;Weight Layer（W2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="2">
          <mxGeometry x="280" y="130" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="6" value="恒等捷径&#xa;Identity Shortcut&#xa;（无参数，维度相同时）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="2">
          <mxGeometry x="60" y="250" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="7" value="逐元素相加&#xa;Element-wise Addition&#xa;F(x) + x" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="2">
          <mxGeometry x="540" y="300" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="8" value="ReLU&#xa;σ(y)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="2">
          <mxGeometry x="540" y="380" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="9" value="输出 y = F(x,{Wᵢ})+x&#xa;Output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="2">
          <mxGeometry x="540" y="450" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="17" value="投影捷径 Ws·x&#xa;Projection Shortcut（1×1 卷积）&#xa;（仅维度不匹配时）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="18" value="输入图像&#xa;Input Image（ImageNet 224×224）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="19" value="conv1：7×7 卷积 64, stride 2 + 3×3 最大池化 /2&#xa;Input Stem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="620" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="20" value="堆叠残差块（深层网络）&#xa;Stacked Residual Blocks&#xa;conv2–conv5：×3/×4/×6/×3，stride-2 下采样、通道数加倍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="21" value="全局平均池化&#xa;Global Average Pooling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="940" y="620" width="160" height="60" as="geometry" />
        </mxCell>
