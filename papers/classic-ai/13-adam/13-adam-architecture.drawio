<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Adam-Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="90" value="随机目标函数 / Stochastic Objective&#xa;f_t(θ): minibatch 抽样 + dropout 等噪声" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="40" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="91" value="梯度 / Gradient&#xa;g_t = ∇_θ f_t(θ_{t−1})" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="190" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="92" value="一阶矩估计 / First Moment Estimate&#xa;m_t = β₁·m_{t−1} + (1−β₁)·g_t&#xa;β₁ = 0.9 (类似动量)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="330" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="93" value="二阶矩估计 / Second Moment Estimate&#xa;v_t = β₂·v_{t−1} + (1−β₂)·g_t²&#xa;β₂ = 0.999" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="330" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="94" value="偏差校正一阶矩 / Bias-corrected m̂_t&#xa;m̂_t = m_t / (1−β₁^t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="250" y="500" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="95" value="偏差校正二阶矩 / Bias-corrected v̂_t&#xa;v̂_t = v_t / (1−β₂^t); 消除从 0 初始化产生的早期偏差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="860" y="500" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="96" value="参数更新 / Parameter Update&#xa;θ_t = θ_{t−1} − α·m̂_t / (√v̂_t + ε)&#xa;α = 0.001, ε = 10^-8; 每参数自适应步长, 有效步长 ≤ α" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="670" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="97" value="AdaGrad (对比 / Compare)&#xa;θ ← θ − α·g / √Σg²: 累加全部历史梯度平方,&#xa;步长只减不增; 擅长稀疏梯度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="850" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="98" value="RMSProp (对比 / Compare)&#xa;对缩放后的梯度再做动量, 无偏差校正;&#xa;适合非平稳目标; β₂ 接近 1 时早期步长过大易发散" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="860" y="850" width="420" height="110" as="geometry" />
        </mxCell>

