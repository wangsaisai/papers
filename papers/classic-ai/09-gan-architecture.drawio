<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="GAN-对抗博弈全景">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="随机噪声 z ~ pz&#xa;Random Noise Prior&#xa;（输入先验分布）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="生成器 G&#xa;Generator G(z; θg)&#xa;（多层感知机 MLP）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="250" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="生成样本 G(z)&#xa;Generated Samples&#xa;（隐含分布 pg）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5" value="真实数据 x ~ pdata&#xa;Real Data&#xa;（训练样本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="6" value="判别器 D&#xa;Discriminator D(x; θd)&#xa;（多层感知机，输出标量）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="770" y="155" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7" value="真/假判定 D(x)&#xa;Real / Fake Probability&#xa;最优解 D* = pdata/(pdata+pg)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="990" y="155" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="8" value="对抗价值函数 V(D,G)&#xa;Minimax Objective&#xa;min_G max_D E[log D(x)] + E[log(1−D(G(z)))]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="400" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="9" value="对抗训练更新&#xa;Backpropagation Updates&#xa;（交替：k 步优化 D，1 步优化 G，k = 1）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="490" y="400" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="10" value="收敛：pg = pdata&#xa;Global Optimum&#xa;D(x) ≡ 1/2（真假无法区分）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="920" y="400" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="11" value="输入先验 pz 采样" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="3">
