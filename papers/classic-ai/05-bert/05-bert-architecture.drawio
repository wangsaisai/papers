        <mxCell id="bdata" value="下游任务数据（带标签）&#xa;Downstream Task Data (labeled)&#xa;如：问答对、推理句对、分类句子" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bpanel2">
