        </mxCell>
        <mxCell id="bnote" value="每个下游任务分别微调（Separate fine-tuned models）&#xa;同一套预训练权重初始化 → 每任务一套微调参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="bpanel2">
          <mxGeometry x="140" y="800" width="600" height="90" as="geometry" />
