        <mxCell id="btok" value="词嵌入&#xa;Token Embedding&#xa;WordPiece · 3 万词表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="binp">
          <mxGeometry x="30" y="50" width="180" height="70" as="geometry" />
