        </mxCell>
        <mxCell id="bcorp" value="预训练语料（无标注文本）&#xa;Pre-training Corpus (unlabeled)&#xa;BooksCorpus 8 亿词 + 英文维基百科 25 亿词" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bpanel1">
