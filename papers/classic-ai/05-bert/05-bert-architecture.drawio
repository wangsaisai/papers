        <mxCell id="btitle" value="BERT 全景架构 · BERT: Pre-training of Deep Bidirectional Transformers（2018）" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
