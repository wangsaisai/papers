        <mxCell id="bseg" value="段嵌入&#xa;Segment Embedding&#xa;区分句 A / 句 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="binp">
          <mxGeometry x="220" y="50" width="180" height="70" as="geometry" />
