        </mxCell>
        <mxCell id="bfenc" value="双向 Transformer 编码器&#xa;Bidirectional Transformer Encoder（L 层）&#xa;结构与预训练相同 · 预训练参数初始化 · 全部参数微调" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="bpanel2">
