          <mxGeometry x="170" y="145" width="300" height="65" as="geometry" />
        </mxCell>
        <mxCell id="be3" value="逐位置前馈网络&#xa;Position-wise FFN · 内层 4H=3072" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="benc">
          <mxGeometry x="170" y="235" width="300" height="65" as="geometry" />
