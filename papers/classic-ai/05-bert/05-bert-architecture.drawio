        <mxCell id="binp" value="输入表示 · Input Representation（[CLS] + 句A + [SEP] + 句B + [SEP]）" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;startSize=30;" vertex="1" parent="bpanel1">
          <mxGeometry x="140" y="150" width="620" height="240" as="geometry" />
