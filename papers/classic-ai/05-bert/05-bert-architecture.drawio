        <mxCell id="bmlm" value="Masked LM 头（MLM Head）&#xa;对 [MASK] 位置预测原词 → 词汇表 Softmax&#xa;替换策略 80% [MASK] · 10% 随机词 · 10% 保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="bpanel1">
          <mxGeometry x="140" y="890" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="bnsp" value="Next Sentence Prediction 头（NSP Head）&#xa;[CLS] 表示 C → 二分类 IsNext / NotNext&#xa;50% 真·下一句 · 50% 随机句" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="bpanel1">
          <mxGeometry x="470" y="890" width="290" height="110" as="geometry" />
