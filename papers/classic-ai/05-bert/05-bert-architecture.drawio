        <mxCell id="bfin" value="任务输入（同一输入表示）&#xa;Task Inputs（同一 [CLS] 构造）&#xa;句A / 句B = 问题/段落 或 前提/假设" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="bpanel2">
