        <mxCell id="bpanel2" value="微调阶段 · Fine-tuning（带标签下游数据）" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;startSize=40;" vertex="1" parent="1">
