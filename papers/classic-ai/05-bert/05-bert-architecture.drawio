        <mxCell id="benc" value="双向 Transformer 编码器 · Bidirectional Transformer Encoder&#xa;L=12（BASE）/ 24（LARGE）层 · 结构同 Transformer 编码器" style="swimlane;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;startSize=40;" vertex="1" parent="bpanel1">
          <mxGeometry x="130" y="420" width="640" height="440" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="双向多头自注意力&#xa;Bidirectional Multi-Head Self-Attention&#xa;每 token 同时看左右上下文（区别于 GPT 单向）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="benc">
          <mxGeometry x="170" y="55" width="300" height="65" as="geometry" />
