        </mxCell>
        <mxCell id="bsout" value="句子级输出层（Sentence-level）&#xa;[CLS] 表示 C → 分类层 W（K×H）→ softmax&#xa;MNLI · SST-2 · SWAG 等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="bpanel2">
          <mxGeometry x="120" y="480" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="btout" value="Token 级输出层（Token-level）&#xa;各位置 T_i → 起止向量 S/E（答案跨度）· 序列标注&#xa;SQuAD 问答 · 命名实体识别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="bpanel2">
          <mxGeometry x="490" y="480" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="btasks" value="下游任务与预测（Downstream Tasks &amp; Predictions）&#xa;GLUE 分类 · SQuAD 问答 · SWAG 常识推理 · CoNLL NER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="bpanel2">
