        </mxCell>
        <mxCell id="v10" value="类比推理评估&#xa;Analogical Reasoning&#xa;vec(Madrid)−vec(Spain)+vec(France)≈vec(Paris)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
