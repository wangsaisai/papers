        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="v1" value="训练语料&#xa;Training Corpus&#xa;10 亿–330 亿词新闻数据" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="短语学习&#xa;Learning Phrases&#xa;score(wᵢ,wⱼ) 超阈值 → 合并为短语 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="高频词降采样&#xa;Subsampling of Frequent Words&#xa;P(wᵢ) = 1 − √(t/f(wᵢ))，t ≈ 10⁻⁵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="中心词–上下文词对&#xa;Center–Context Pairs&#xa;训练样本 (wₜ, wₜ₊ⱼ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="40" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="Skip-gram 模型&#xa;Skip-gram Model&#xa;用中心词 wₜ 预测上下文词 wₜ₊ⱼ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="190" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="层级 Softmax&#xa;Hierarchical Softmax&#xa;Huffman 树，成本 ∝ log₂W" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="340" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="负采样&#xa;Negative Sampling (NEG)&#xa;区分目标词与 k 个噪声词，Pₙ(w)=U(w)^(3/4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="340" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="NCE 噪声对比估计&#xa;Noise Contrastive Estimation&#xa;需要噪声分布的数值概率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="340" width="210" height="70" as="geometry" />
