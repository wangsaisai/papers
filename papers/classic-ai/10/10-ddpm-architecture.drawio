<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="DDPM-扩散模型全景">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="阶段一 · 训练 Training：前向扩散过程 q（固定参数的加噪 Markov 链）" style="swimlane;startSize=32;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1120" height="300" as="geometry" />
        </mxCell>
        <mxCell id="3" value="阶段二 · 采样 Sampling：反向去噪过程 pθ（可学习的逆向 Markov 链）" style="swimlane;startSize=32;html=1;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="1120" height="280" as="geometry" />
        </mxCell>
        <mxCell id="4" value="真实图像 x0&#xa;Real Image x0&#xa;（训练样本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="2">
          <mxGeometry x="30" y="115" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="5" value="高斯噪声 ε ~ N(0,I)&#xa;Gaussian Noise&#xa;（逐 步注入）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="2">
          <mxGeometry x="250" y="115" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="6" value="前向扩散过程 q&#xa;Forward Process&#xa;xt = √ᾱt·x0 + √(1−ᾱt)·ε&#xa;（β1..βT 调度, T=1000）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="2">
          <mxGeometry x="450" y="115" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7" value="纯噪声 xT ≈ N(0,I)&#xa;Pure Noise&#xa;（训练终点，信号被破坏）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="2">
          <mxGeometry x="710" y="115" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="8" value="简化训练目标 L_simple&#xa;Simplified Objective&#xa;E‖ε − εθ(√ᾱt·x0 + √(1−ᾱt)·ε, t)‖²&#xa;（等价多尺度去噪得分匹配）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="9" value="噪声预测网络 εθ(xt, t)&#xa;Noise Predictor&#xa;（U-Net 骨干 + 组归一化 + 16×16 自注意力）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="430" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="10" value="时间步 t&#xa;Timestep t&#xa;（Transformer 正弦位置编码&#xa;输入各层）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="900" y="430" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="11" value="采样起点&#xa;xT ~ N(0,I)&#xa;（与训练终点同分布）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="3">
          <mxGeometry x="30" y="105" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="反向去噪过程 pθ(xt−1|xt)&#xa;Reverse Process&#xa;（高斯条件 + 固定方差 σt²I&#xa;等价退火朗之万动力学）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="3">
          <mxGeometry x="330" y="105" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="13" value="生成图像 x0&#xa;Generated Image&#xa;（迭代 t → 1 的采样输出）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="3">
          <mxGeometry x="770" y="105" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="4" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="15" value="逐步加噪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="16" value="xt−1 → xt（βt 增大，加噪 x1…xT）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="17" value="输入加噪图像 xt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="18" value="t 输入（正弦位置编码）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="19" value="预测噪声 ε̂" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="20" value="梯度下降更新 θ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="8" target="9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="21" value="t = T" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="22" value="每步去噪：1/√αt·(xt − βt/√(1−ᾱt)·εθ(xt,t)) + σt·z" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="23" value="每步调用 εθ(xt, t) 估计噪声方向" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="9" target="12">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="660" />
              <mxPoint x="520" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
