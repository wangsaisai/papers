<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="BatchNorm-Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="Mini-batch 输入&#xa;Input x = {x1...xm}（前层输出）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="3" value="批均值 μ_B&#xa;Mini-batch Mean&#xa;μ_B = (1/m)Σxi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="批方差 σ²_B&#xa;Mini-batch Variance&#xa;σ²_B = (1/m)Σ(xi−μ_B)²" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="5" value="归一化 Normalize&#xa;x̂ = (x − μ_B) / √(σ²_B + ε)&#xa;（ε 防除零常数）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="680" y="140" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="6" value="可学习参数&#xa;Learnable γ, β" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1000" y="320" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="7" value="缩放与平移 Scale &amp; Shift&#xa;y = γ·x̂ + β" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="140" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="8" value="输出 BN(x)&#xa;Output to Nonlinearity&#xa;z = g(BN(Wu))（BN 在激活之前）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1320" y="140" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="9" value="训练模式 Training Mode&#xa;用 mini-batch 统计量 μ_B、σ²_B；BN 变换可微，参与梯度反向传播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="10" value="总体统计量&#xa;Population Statistics&#xa;E[x]、Var[x]（无偏估计/移动平均）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="11" value="推理模式 Inference Mode&#xa;固定总体统计量；归一化与 γ、β 合并为一条线性变换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="980" y="420" width="560" height="90" as="geometry" />
        </mxCell>

