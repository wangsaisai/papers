<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Dropout-Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="60" value="训练小批量 / Training Mini-batch&#xa;SGD 小批量训练样本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="360" y="30" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="61" value="标准网络前向 / Standard Forward&#xa;所有隐藏单元在场;&#xa;特征检测器共同适应 (co-adaptation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="62" value="标准反向传播 / Standard Backprop&#xa;更新所有权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="63" value="过拟合 / Overfitting&#xa;训练集拟合得很好,&#xa;held-out 测试集表现差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="64" value="Dropout 随机丢弃 / Random Omission&#xa;每训练样本, 每个隐藏单元以 0.5 概率移除&#xa;(输入层可 0.2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="65" value="随机子网络 / Stochastic Sub-network&#xa;每次训练样本几乎对应不同子网络;&#xa;共享仍在场单元的权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="66" value="反向传播 + SGD / Backprop with SGD&#xa;更新共享权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="500" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="67" value="Max-norm 权重约束 / Weight Constraint&#xa;每单元输入权重设 L2 范数上限, 超限按比例缩放;&#xa;代替权重衰减, 支持大学习率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="660" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="68" value="防共同适应 / No Co-adaptation&#xa;每个单元学会独立有用的特征, 泛化提升" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="600" y="820" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="69" value="均值网络 / Mean Network (测试时)&#xa;所有隐藏单元在场, 输出权重减半" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="980" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="70" value="≈ 2^N 个子网络的集成 / Ensemble of 2^N Sub-nets&#xa;单隐藏层 + softmax 时与几何平均严格等价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="720" y="980" width="420" height="90" as="geometry" />
        </mxCell>

